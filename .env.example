# Primer administrador. Solo se usa si todavía no hay ningún usuario.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Tesorero

# Carpeta de la base de datos (en Docker: /data, con volumen persistente)
DATA_DIR=./data
PORT=3000
TZ_APP=America/Argentina/Buenos_Aires

# Opcional: envío de mails. Si se dejan vacías, el sistema no manda mails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
